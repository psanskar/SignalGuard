{
  "name": "SignalGuard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",

  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",

  "forwardPorts": [5000, 5500],

  "portsAttributes": {
    "5000": {
      "label": "SignalGuard API",
      "onAutoForward": "notify"
    },
    "5500": {
      "label": "SignalGuard Frontend",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Gemini API key used by SignalGuard's explanation layer.",
      "documentationUrl": "https://ai.google.dev/"
    }
  }
}